{
  "schema_version": 1,
  "contract_name": "provider-invocation-v1",
  "provider_id": "mac-mm-01",
  "transport": "pull_ssh_v1",
  "enabled": true,
  "allowed_capabilities": [
    "C0_FETCH",
    "C1_RENDER",
    "C2_INSPECT",
    "C3_BROWSER_USE",
    "DOCUMENT_OCR"
  ],
  "tool_map": {
    "C0_FETCH": "browser_fetch",
    "C1_RENDER": "browser_render",
    "C2_INSPECT": "browser_inspect",
    "C3_BROWSER_USE": "browser_use",
    "DOCUMENT_OCR": "document_ocr"
  },
  "limits": {
    "max_run_seconds": 180,
    "max_request_ttl_seconds": 180,
    "max_bytes": 16777216
  },
  "security": {
    "https_only": true,
    "arbitrary_url_allowed": false,
    "arbitrary_shell_allowed": false,
    "public_mac_listener_allowed": false,
    "off_host_redirect_allowed": false,
    "personal_chrome_profile_allowed": false
  },
  "source_policies": {
    "S38": {
      "enabled": true,
      "source_policy_version": 1,
      "allowed_capabilities": [
        "C0_FETCH"
      ],
      "targets": {
        "LISTING": {
          "exact_urls": [
            "https://www.industrymsme.gov.mm/announcements"
          ],
          "capabilities": [
            "C0_FETCH"
          ],
          "max_bytes": 1000000,
          "max_run_seconds": 90
        },
        "DETAIL": {
          "https_host": "www.industrymsme.gov.mm",
          "path_prefix": "/announcements/",
          "capabilities": [
            "C0_FETCH"
          ],
          "max_bytes": 1000000,
          "max_run_seconds": 90,
          "allow_query": false,
          "allow_fragment": false,
          "final_url_policy": {
            "mode": "APPROVED_HOST_PATH",
            "https_host": "www.industrymsme.gov.mm",
            "path_prefix": "/announcements/"
          }
        }
      }
    },
    "S27": {
      "enabled": true,
      "source_policy_version": 1,
      "allowed_capabilities": [
        "C0_FETCH"
      ],
      "targets": {
        "LISTING": {
          "exact_urls": [
            "https://moba.gov.mm/my/tender"
          ],
          "capabilities": [
            "C0_FETCH"
          ],
          "max_bytes": 1000000,
          "max_run_seconds": 90
        },
        "DETAIL": {
          "https_host": "moba.gov.mm",
          "path_prefix": "/my/tender/",
          "capabilities": [
            "C0_FETCH"
          ],
          "max_bytes": 1000000,
          "max_run_seconds": 90,
          "allow_query": false,
          "allow_fragment": false,
          "final_url_policy": {
            "mode": "APPROVED_HOST_PATH",
            "https_host": "moba.gov.mm",
            "path_prefix": "/my/tender/"
          }
        }
      }
    },
    "S01": {
      "enabled": true,
      "source_policy_version": 2,
      "allowed_capabilities": [
        "DOCUMENT_OCR"
      ],
      "targets": {
        "OFFICIAL_DOCUMENT": {
          "https_host": "myanmar.gov.mm",
          "path_prefix": "/documents/",
          "capabilities": [
            "DOCUMENT_OCR"
          ],
          "max_bytes": 8000000,
          "max_run_seconds": 150,
          "allow_query": false,
          "allow_fragment": false,
          "final_url_policy": {
            "mode": "APPROVED_HOST_PATH",
            "https_host": "myanmar.gov.mm",
            "path_prefix": "/documents/"
          }
        }
      }
    }
  }
}
