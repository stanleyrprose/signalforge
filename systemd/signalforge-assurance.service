[Unit]
Description=SignalForge weekly assurance and miss-detection review
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=signalforge
Group=signalforge
Environment=SIGNALFORGE_STATE_ROOT=/srv/signalforge/state
Environment=SIGNALFORGE_EVIDENCE_ROOT=/srv/signalforge/evidence
Environment=SIGNALFORGE_DB=/srv/signalforge/state/signalforge.db
ExecStart=/srv/signalforge/active/bin/signalforge assurance-run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/signalforge/state /srv/signalforge/locks
