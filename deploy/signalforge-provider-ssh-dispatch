#!/bin/sh
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
  provider-claim-v1|provider-submit-v1|provider-fail-v1|provider-status-v1|translation-claim-v1|translation-submit-v1|translation-fail-v1|translation-status-v1)
    exec /usr/bin/sudo -n -u signalforge /usr/bin/env "SSH_ORIGINAL_COMMAND=${SSH_ORIGINAL_COMMAND}" /srv/signalforge/active/bin/signalforge-provider-dispatcher
    ;;
  *)
    printf '{"status":"DENY","error":"unsupported provider command"}\n'
    exit 126
    ;;
esac
